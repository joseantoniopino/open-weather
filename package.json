{
  "name": "02-weather",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "verify": "bun run typecheck && bun run test",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "build": "bun run verify && bun build --compile --outfile weather-cli src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
